# Python
__pycache__/
*.pyc

# Virtualenv created by setup_env.sh
env/

# Generated plot/output artifacts
lineshape/results/

# Auto-generated temporary / retry slurm filelists
slurm/filelists/_*

# CVH hotspot-2 study: large caches and cmsRun outputs (regenerable)
module_level_corrections/*.npz
module_level_corrections/runtree_map*/
module_level_corrections/diag_run*/

# resolution study caches and job logs (multi-GB npz + logs)
resolution/runs/
resolution/runs_*.log
# ... and its scan caches, the same rule module_level_corrections already has
resolution/*.npz

# pixelhits study: cmsRun outputs, per-job logs and pickled caches.
# 13.3 GB of globalcor ntuples + 1.9 GB of logs, all regenerable from the
# drivers and filelists that ARE committed.  `pixelhits/lagun/ana_*.log` alone
# is 1.8 GB -- the two largest files in the tree.
pixelhits/runs/
pixelhits/lagun/*.root
pixelhits/lagun/*.log
pixelhits/lagun/resp_*.txt

# slurm array stdout, captured next to the job rather than in a log dir
**/slurm_*.out

# Machine-generated chunk/retry filelists.  The HAND-MAINTAINED ones are
# tracked and stay tracked (pixelhits/filelist_data_all.txt,
# resolution/simprod/filelist_*.txt, slurm/filelists/jpsi_2016_*.txt); these
# are the ones a script writes.  The existing `slurm/filelists/_*` rule was
# meant to catch the retry lists and the naming drifted away from it.
pixelhits/filelist_mc*.txt
pixelhits/filelist_jpsimc*.txt
slurm/filelists/*retry*.txt
slurm/filelists/*redo*.txt
slurm/filelists/*resubmit*.txt

# Grid->ceph transfer runtime state (regenerable; status log grows per file)
transfer/logs/
transfer/transfer_status.tsv*

# Z channel: gen dumps, FSR kernels, pairs caches, datacards (all regenerable).
# The generator record and the two provenance files it was read from are NOT
# regenerable without the gridpack, and are the reference the lineshape kernel
# closes against, so they are kept.  (A blanket `zchannel/data/` would make the
# negations below impossible -- git cannot re-include inside an excluded dir.)
zchannel/data/*
!zchannel/data/generator_settings_*.md
!zchannel/data/prov/
zchannel/data/prov/*
!zchannel/data/prov/pwhg_main_init.log
!zchannel/data/prov/powheg.input

# oddmoment study outputs (regenerable tables + npz)
resolution/oddmoment/out/
resolution/oddmoment/tmp/
production/.watch_dy_recover.pid
production/.watch_dy_recover.stop
production/.watch_dy_recover.counts

# fullscale: multi-GB pairs caches, datacards and job logs, all regenerable
# from the scripts and the productions
fullscale/runs/
fullscale/cards/
fullscale/logs/

# fullscale fit results: 0.8 MB of embedded provider config each, and every
# number that matters is in fullscale/STATE.md and fullscale/PHASE1.md
fullscale/results/*.json
!fullscale/results/gate_*.json
# the convergence verdicts (EDM + the full Newton step per POI) are 1.5 kB each
# and they are the certification of every quoted number -- keep them
!fullscale/results/conv_*.json
fullscale/results/*.hdf5
fullscale/results/*.txt
# rabbit_fit.py results: 77 kB each, and they carry the value, the NLL and the
# EDM the acceptance test of STATE sec. 0f.16 is made of
!fullscale/results/native/rabbit_*.hdf5
fullscale/results/native/*.snapshot.hdf5
fullscale/results/eng/
fullscale/results/nativejson/

# hit-class location study caches (regenerable, ~200 MB)
resolution/hitclassbias/data/
